                fieldset(ui, &entry.name, |ui| {
                    ui.horizontal(|ui| {
                        ui.label(format!("Backend: {}", entry.backend));
                        ui.separator();
                        ui.label(format!("Version: {}", entry.version));
                        ui.separator();
                        ui.label(format!("Installed: {}", entry.is_installed));
